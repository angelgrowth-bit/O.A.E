# ─────────────────────────────────────────────────────────────────────────────
# EU TRACKER COURIER — variables de entorno
#
# En desarrollo no hace falta tocar casi nada: `npm run dev` rellena solo
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL y SCOPES.
# Copia este archivo a `.env` y ajusta lo que necesites.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos.
#   Desarrollo (SQLite, cero configuración):
DATABASE_URL="file:./dev.sqlite"
#   Producción (PostgreSQL) — ver README, apartado "Pasar a producción":
# DATABASE_URL="postgresql://usuario:contrasena@servidor:5432/eutracker?schema=public"

# Credenciales de la app. Las gestiona la CLI de Shopify; en tu servidor de
# producción tendrás que ponerlas a mano (las ves en el Partner Dashboard).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# URL pública de la app. En desarrollo la pone la CLI (túnel de Cloudflare).
# En producción, tu dominio: https://tracker.midominio.com
SHOPIFY_APP_URL=""

# Permisos solicitados. Deben coincidir con los de shopify.app.toml.
SCOPES="read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_locations"

# ── Opcionales ───────────────────────────────────────────────────────────────

# Secreto para el disparador externo del planificador (POST /api/cron).
# Solo hace falta en hosts que apagan el proceso cuando no hay tráfico.
# Genera uno con: openssl rand -hex 32
# CRON_SECRET=""

# Pon "1" para desactivar el temporizador interno (si usas solo /api/cron).
# EUTC_DISABLE_SCHEDULER="0"
